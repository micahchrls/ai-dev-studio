{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "advisorModel": "opus",
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git clean -fd *)",
      "Bash(git clean -xfd *)",
      "Bash(git branch -D *)",
      "Read(~/ai-dev-studio/vault/.obsidian/**)",
      "Edit(~/ai-dev-studio/vault/.obsidian/**)",
      "Bash(obsidian eval *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": [
      "~/ai-dev-studio/vault"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "studio@ai-dev-studio": true
  }
}
