{
  "_comment": "Shared regression cases for git_guard.py and its JavaScript port on the studio map page. branch = the current branch of the test repo.",
  "cases": [
    {"cmd": "git status", "expect": "allow"},
    {"cmd": "git push origin feature", "expect": "allow"},
    {"cmd": "git push -u origin feature", "expect": "allow"},
    {"cmd": "git checkout -b new-thing", "expect": "allow"},
    {"cmd": "git restore --staged a.txt", "expect": "allow"},
    {"cmd": "git restore -S a.txt", "expect": "allow"},
    {"cmd": "git branch -d merged", "expect": "allow"},
    {"cmd": "git log --oneline", "expect": "allow"},
    {"cmd": "git reset --soft HEAD~1", "expect": "allow"},
    {"cmd": "git clean -n", "expect": "allow"},
    {"cmd": "npm test && git commit -m wip", "expect": "allow"},
    {"cmd": "echo git push --force", "expect": "allow"},
    {"cmd": "grep -r 'reset --hard' docs", "expect": "allow"},
    {"cmd": "git push", "expect": "allow", "branch": "feature"},

    {"cmd": "cat > f.js <<'EOF'\nvar x = 1; /usr/bin/git clean -xfd\nEOF", "expect": "allow", "note": "heredoc body is data"},
    {"cmd": "cat <<EOF > notes.md\ngit reset --hard\nEOF", "expect": "allow", "note": "unquoted heredoc, still data"},
    {"cmd": "node -e \"console.log('a; git push --force')\"", "expect": "allow", "note": "quoted script text"},
    {"cmd": "git commit -m \"wip; git clean -fd\"", "expect": "allow", "note": "semicolon inside a commit message"},
    {"cmd": "printf '%s\\n' 'git push --force' > doc.md", "expect": "allow"},
    {"cmd": "git log --grep='reset --hard'", "expect": "allow"},

    {"cmd": "git push --force", "expect": "block"},
    {"cmd": "git push -f origin feature", "expect": "block"},
    {"cmd": "git -C . push --force-with-lease", "expect": "block"},
    {"cmd": "git push origin +feature", "expect": "block"},
    {"cmd": "git push origin main", "expect": "block"},
    {"cmd": "git push origin HEAD:main", "expect": "block"},
    {"cmd": "cd x && git reset --hard", "expect": "block"},
    {"cmd": "git clean -fd", "expect": "block"},
    {"cmd": "git branch -D old", "expect": "block"},
    {"cmd": "git checkout -- .", "expect": "block"},
    {"cmd": "git checkout .", "expect": "block"},
    {"cmd": "git restore src/a.ts", "expect": "block"},
    {"cmd": "git stash clear", "expect": "block"},
    {"cmd": "git filter-branch --all", "expect": "block"},
    {"cmd": "GIT_TRACE=1 git push --force", "expect": "block"},
    {"cmd": "sudo git reset --hard", "expect": "block"},
    {"cmd": "true; /usr/bin/git clean -xfd", "expect": "block"},
    {"cmd": "git push", "expect": "block", "branch": "main"},

    {"cmd": "bash <<'EOF'\ngit push --force\nEOF", "expect": "block", "note": "heredoc fed to a shell runs"},
    {"cmd": "bash -c 'git reset --hard'", "expect": "block"},
    {"cmd": "sh -c \"cd x && git clean -fd\"", "expect": "block"},
    {"cmd": "zsh -c 'git -C repo push origin main'", "expect": "block"},
    {"cmd": "echo \"$(git stash clear)\"", "expect": "block", "note": "command substitution inside double quotes runs"},
    {"cmd": "eval git push --force", "expect": "block"},
    {"cmd": "git status\ngit reset --hard", "expect": "block", "note": "newline separates commands"}
  ]
}
