{
  "description": "Studio git safety: block destructive or history-rewriting git commands and pushes to main/master.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
