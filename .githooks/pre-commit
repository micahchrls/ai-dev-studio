#!/usr/bin/env bash
# Studio repo guard: this repo is public. Refuse commits that stage anything from the private
# vault or from project repos (e.g. after an accidental `git add -f`).
# Enabled with: git config core.hooksPath .githooks
staged=$(git diff --cached --name-only)
bad=$(printf '%s\n' "$staged" | grep -E '^(vault/|projects/)' | grep -vxF 'projects/README.md' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit private vault/ or projects/ files to the public studio repo:" >&2
  printf '  %s\n' $bad >&2
  echo "Unstage them with: git rm --cached -r <path>   (keeps the files on disk)" >&2
  exit 1
fi
